# Modify this file and rename this file to .cert_manager.env

EMAIL="your-email@your-domain.com"
DATE=$(date +'%Y%m%d')
LOG_PATH="/var/log/letsencrypt/"
LOG_FILE="$LOG_PATH""${DATE}.log"
LOG_RETENTION_DAYS=10
PF_CONF="/etc/pf.conf"
PF_CONF_TEMP="/etc/pf.conf.temp"
WEBROOT_PATH="/var/www/letsencrypt"
OS=$(uname -s)
NGINX_ENABLED="/etc/nginx/sites-enabled"
CERTBOT="/usr/local/bin/certbot"

# Post-renewal actions
# DEFAULT_ACTION is executed for any renewed cert that has no domain-specific entry.
DEFAULT_ACTION="nginx -s reload"

# Per-domain actions. Format: "domain,command_or_script_path"
# Multiple entries for the same domain are all executed.
# Actions that are identical across domains run only once per renewal cycle.
# ACTIONS=(
#   "example.com,nginx -s reload"
#   "vpn.example.com,/etc/letsencrypt/scripts/update_openvpn_cert.sh vpn.example.com"
# )

# Certbot renewal method
# DEFAULT_RENEWALL_METHOD sets the method used when no per-domain entry matches.
# W = webroot (default), S = standalone
DEFAULT_RENEWALL_METHOD="W"

# Per-domain renewal method. Format: "domain,[S|W]"
# S = standalone, W = webroot
# Overrides DEFAULT_RENEWALL_METHOD for the listed domains.
# RENEWALL_METHOD=(
#   "vpn.example.com,S"
#   "www.example.com,W"
# )
